# local/versions.tf -- dockerwebsite stack pins, same discipline as AX-Fabric.
terraform {
  required_version = ">= 1.9.0"

  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "docker" {
  # Empty = auto-detect Docker Desktop on this machine.
}
